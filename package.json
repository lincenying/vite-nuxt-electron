{
  "name": "vite-nuxt-electron",
  "version": "2.0.0",
  "private": true,
  "description": "A simple starter app built with just Electron, Vue3, Typescript, and Vite",
  "author": "LinCenYing <lincenying@gmail.com>",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "nuxi prepare",
    "serve": "pnpm app:dev",
    "build": "pnpm app:build",
    "preview": "pnpm app:preview",
    "nuxt:postinstall": "nuxt prepare",
    "nuxt:dev": "NUXT_ELECTRON_ENABLED=false nuxt dev",
    "nuxt:build": "NUXT_ELECTRON_ENABLED=false nuxt build",
    "nuxt:generate": "NUXT_ELECTRON_ENABLED=false nuxt generate",
    "nuxt:preview": "NUXT_ELECTRON_ENABLED=false nuxt preview",
    "app:dev": "NUXT_ELECTRON_ENABLED=true nuxt dev",
    "app:build": "NUXT_ELECTRON_ENABLED=true nuxt build && tsc && electron-builder",
    "app:preview": "NUXT_ELECTRON_ENABLED=true nuxt build && tsc && electron .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ts": "vue-tsc --noEmit",
    "typecheck": "nuxt typecheck",
    "lint:css": "stylelint '**/*.{css,scss}' --fix",
    "pack": "electron-builder",
    "electron:generate-icons": "electron-icon-builder --input=./public/favicon.png --output=build --flatten"
  },
  "build": {
    "appId": "your.app.id",
    "productName": "Electron模板",
    "asar": false,
    "directories": {
      "buildResources": "assets",
      "output": "release/${version}"
    },
    "files": [
      ".output/**/*",
      "dist-electron"
    ],
    "mac": {
      "artifactName": "${productName}_${version}.${ext}",
      "target": [
        "dmg"
      ],
      "icon": "./build/icons/icon.icns"
    },
    "win": {
      "artifactName": "${productName}_${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "./build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "./build/icons/icon.ico",
      "uninstallerIcon": "./build/icons/icon.ico"
    }
  },
  "devDependencies": {
    "@element-plus/nuxt": "catalog:",
    "@iconify-json/carbon": "catalog:",
    "@iconify-json/twemoji": "catalog:",
    "@lincy/async-validation": "catalog:",
    "@lincy/eslint-config": "catalog:",
    "@lincy/stylelint-config": "catalog:",
    "@lincy/unocss-base-config": "catalog:",
    "@lincy/utils": "catalog:",
    "@nuxt/image": "catalog:",
    "@nuxtjs/color-mode": "catalog:",
    "@pinia/nuxt": "catalog:",
    "@types/md5": "catalog:",
    "@types/mockjs": "catalog:",
    "@types/nprogress": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@unocss/eslint-config": "catalog:",
    "@unocss/nuxt": "catalog:",
    "@vue-macros/nuxt": "catalog:",
    "@vueuse/nuxt": "catalog:",
    "better-sqlite3": "catalog:",
    "concurrently": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-icon-builder": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "md-editor-v3": "catalog:",
    "md5": "catalog:",
    "mockjs": "catalog:",
    "nprogress": "catalog:",
    "nuxt": "catalog:",
    "nuxt-electron": "catalog:",
    "pinia": "catalog:",
    "sass": "catalog:",
    "store2": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-electron": "catalog:",
    "vite-plugin-electron-renderer": "catalog:",
    "vue": "catalog:",
    "vue-inline-svg": "catalog:",
    "vue-tsc": "catalog:"
  }
}
