{
  "name": "vite-nuxt-electron",
  "version": "2.0.0",
  "private": true,
  "description": "A simple starter app built with just Electron, Vue3, Typescript, and Vite",
  "author": "LinCenYing <lincenying@gmail.com>",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "nuxi prepare",
    "serve": "pnpm app:dev",
    "build": "pnpm app:build",
    "preview": "pnpm app:preview",
    "nuxt:postinstall": "nuxt prepare",
    "nuxt:dev": "nuxt dev",
    "nuxt:build": "nuxt build",
    "nuxt:generate": "nuxt generate",
    "nuxt:preview": "nuxt preview",
    "app:dev": "nuxt dev",
    "app:build": "pnpm nuxt:build && tsc && electron-builder",
    "app:preview": "pnpm nuxt:build && tsc && electron .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ts": "vue-tsc --noEmit",
    "typecheck": "nuxt typecheck",
    "lint:css": "stylelint '**/*.{css,scss}' --fix",
    "pack": "electron-builder",
    "electron:generate-icons": "electron-icon-builder --input=./public/favicon.png --output=build --flatten"
  },
  "build": {
    "appId": "your.app.id",
    "productName": "Electron模板",
    "asar": false,
    "directories": {
      "buildResources": "assets",
      "output": "release/${version}"
    },
    "files": [
      ".output/**/*",
      "dist-electron"
    ],
    "mac": {
      "artifactName": "${productName}_${version}.${ext}",
      "target": [
        "dmg"
      ],
      "icon": "./build/icons/icon.ico"
    },
    "win": {
      "artifactName": "${productName}_${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "./build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "./build/icon.ico",
      "uninstallerIcon": "./build/icon.ico"
    }
  },
  "devDependencies": {
    "@element-plus/nuxt": "^1.1.5",
    "@iconify-json/carbon": "^1.2.23",
    "@iconify-json/twemoji": "^1.2.5",
    "@lincy/async-validation": "^1.4.0",
    "@lincy/eslint-config": "^7.2.0",
    "@lincy/stylelint-config": "^2.2.3",
    "@lincy/unocss-base-config": "^2.7.3",
    "@lincy/utils": "^0.7.3",
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "@types/md5": "^2.3.6",
    "@types/mockjs": "^1.0.10",
    "@typescript-eslint/parser": "^8.62.1",
    "@unocss/eslint-config": "^66.7.4",
    "@unocss/nuxt": "^66.7.4",
    "@vue-macros/nuxt": "^3.1.2",
    "@vueuse/nuxt": "^14.3.0",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^10.0.3",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-format": "^2.0.1",
    "md-editor-v3": "^6.5.3",
    "md5": "^2.3.0",
    "mockjs": "^1.1.0",
    "nuxt": "^4.4.8",
    "nuxt-electron": "^0.7.0",
    "pinia": "^3.0.4",
    "sass": "^1.101.0",
    "store2": "^2.14.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue": "^3.5.39",
    "vue-inline-svg": "^4.0.1",
    "vue-tsc": "^3.3.5"
  }
}
